{
  "name": "@ajh/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "node build.mjs",
    "start": "NODE_ENV=production node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "capture": "tsx --env-file-if-exists=../../.env src/cli/capture.ts",
    "reprocess": "tsx --env-file-if-exists=../../.env src/cli/reprocess.ts"
  },
  "dependencies": {
    "@ajh/database": "workspace:*",
    "@ajh/job-sources": "workspace:*",
    "@ajh/shared": "workspace:*",
    "@fastify/static": "^10.1.6",
    "better-sqlite3": "^13.0.3",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "kysely": "^0.29.7",
    "pino": "^10.4.0",
    "sanitize-html": "^2.18.1",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
